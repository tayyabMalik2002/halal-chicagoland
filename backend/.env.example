# Copy this file to .env and fill in your local values.

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection (used by src/config/db.js)
# Preferred: a single connection string (works for Azure Database for
# PostgreSQL, which requires SSL — include sslmode=require).
DATABASE_URL=postgresql://zabiha_app:changeme@127.0.0.1:5432/zabiha_halal_db?sslmode=require

# Alternative to DATABASE_URL: discrete host/port/user/password/name vars.
# Only used if DATABASE_URL is unset.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=zabiha_app
DB_PASSWORD=changeme
DB_NAME=zabiha_halal_db
DB_CONNECTION_LIMIT=10

# Separate test database (used only when NODE_ENV=test, e.g. by Jest)
TEST_DATABASE_URL=postgresql://zabiha_app:changeme@127.0.0.1:5432/zabiha_halal_db_test?sslmode=require
TEST_DB_NAME=zabiha_halal_db_test

# AI Menu Analyzer (used by src/services/aiMenuService.js)
# Leave blank to run in mock/demo mode: canned sample responses instead of
# real API calls, so the feature is usable without a key. A "Demo Mode"
# badge appears in the UI whenever this is active.
ANTHROPIC_API_KEY=
