# Copy this file to .env and fill in your local values.

# Server
PORT=3000
NODE_ENV=development

# MySQL connection (used by src/config/db.js)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zabiha_app
DB_PASSWORD=changeme
DB_NAME=zabiha_halal_db
DB_CONNECTION_LIMIT=10

# Separate test database (used only when NODE_ENV=test, e.g. by Jest)
TEST_DB_NAME=zabiha_halal_db_test
